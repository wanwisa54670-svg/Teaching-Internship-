rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Connection health-check probe
    match /test/{testId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // User profile document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // Subcollections owned by user
      match /weekly_logs/{logId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(logId);
        allow delete: if isOwner(userId);
      }

      match /academic_items/{itemId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(itemId);
        allow delete: if isOwner(userId);
      }

      match /school_photos/{photoId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(photoId);
        allow delete: if isOwner(userId);
      }

      match /attendance/{recordId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(recordId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
